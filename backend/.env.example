# ============================================
# GAWANDE KRUSHI KENDRA - INVOICE AUTOMATION
# ============================================

# ===================
# SHOP DETAILS
# ===================
SHOP_NAME=Gawande Krushi Kendra
SHOP_ADDRESS=Your Shop Address, City, State, PIN
SHOP_PHONE=9876543210
SHOP_EMAIL=contact@gawandekrushi.com
SHOP_GSTIN=27AABCU9603R1ZX

# ===================
# INVOICE SETTINGS
# ===================
AUTO_GENERATE_INVOICE=true

# GST Rates (%)
INVOICE_CGST_RATE=9
INVOICE_SGST_RATE=9
INVOICE_IGST_RATE=18

# ===================
# BOTBIZ WHATSAPP CONFIG
# ===================
# Get these from https://botbiz.in
BOTBIZ_API_URL=https://api.botbiz.in
BOTBIZ_API_KEY=your_botbiz_api_key_here
BOTBIZ_DEVICE_ID=your_device_id_here

# ===================
# PUPPETEER CONFIG (Optional)
# ===================
# Only set if you need a custom Chrome executable path
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# ===================
# ADMIN CONFIG
# ===================
# Comma-separated admin emails (these users will get admin role on login)
ADMIN_EMAILS=gawandekrushikendra@gmail.com

# ===================
# EXISTING CONFIG (Don't remove)
# ===================
NODE_ENV=development
PORT=5000

MONGO_URI=mongodb://localhost:27017/gkk

JWT_ACCESS_SECRET=your_jwt_access_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret

CLIENT_URL=http://localhost:5173
SESSION_SECRET=your_session_secret

# Email (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@gawandekrushi.com

# Razorpay (Optional)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret